<%
    String adminPath = request.getServletPath();
    if (adminPath == null) {
        adminPath = "";
    }
%>
<link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

<div class="admin-hero mb-4">
    <div style="padding-bottom: 30px">
        <a class="navbar-brand fw-bold" href="/ecommerce-1.0-SNAPSHOT/home">MyShop</a>
    </div>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <div class="eyebrow mb-2">
                <span class="dot" aria-hidden="true"></span>
                Console admin
            </div>
            <h1 class="mb-1">Administration</h1>
            <p class="text-muted mb-0">Manage the catalog, categories, promotions, and immersive variations without leaving this dashboard.</p>
        </div>
        <div class="admin-toolbar">
            <span class="badge-subcategory">Edit modals</span>
            <div class="placeholder-banner mb-0">Optimized experience</div>
        </div>
    </div>
    <nav class="admin-nav mt-3">
        <a class="admin-nav-link <%= adminPath.contains("/admin/products") ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin/products">
            Products
        </a>
        <a class="admin-nav-link <%= adminPath.contains("/admin/categories") ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin/categories">
            Categories
        </a>
        <a class="admin-nav-link <%= adminPath.contains("/admin/subcategories") ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin/subcategories">
            Sub-categories
        </a>
        <a class="admin-nav-link <%= adminPath.contains("/admin/promotions") ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin/promotions">
            Promotions
        </a>
        <a class="admin-nav-link <%= adminPath.contains("/admin/orders") ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin/orders">
            Orders
        </a>
        <a
                href="${pageContext.request.contextPath}/logout"
                class="btn btn-sm btn-danger d-inline-flex align-items-center gap-2 shadow-sm logout-btn">
            <i class="bi bi-box-arrow-right"></i>
            <span class="fw-semibold">Logout</span>
        </a>
    </nav>
</div>
