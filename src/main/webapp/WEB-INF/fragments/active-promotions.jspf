<%
    String promotionLoadError = (String) request.getAttribute("promotionLoadError");
    if (promotionLoadError != null) {
%>
<div class="alert alert-warning"><%= promotionLoadError %></div>
<%
    } else {
        java.util.List<org.example.model.Promotion> activePromotions =
                (java.util.List<org.example.model.Promotion>) request.getAttribute("activePromotions");
        if (activePromotions != null && !activePromotions.isEmpty()) {
            String variant = (String) request.getAttribute("promotionDisplayMode");
    java.time.format.DateTimeFormatter dateFormatter = java.time.format.DateTimeFormatter.ofPattern("dd MMM yyyy HH:mm");
            java.text.DecimalFormat decimalFormat = new java.text.DecimalFormat("#.##");
%>
<section class="my-5 <%= variant != null ? "active-promotions-section--" + variant : "" %>">
    <div class="section-heading mb-4">
        <h2 class="h4">Active promotions</h2>
        <p class="mb-0">Offers end automatically when the countdown reaches zero.</p>
    </div>
    <div class="row g-3">
        <%
            for (org.example.model.Promotion promo : activePromotions) {
                java.time.LocalDateTime startTime = promo.getStartTime();
                java.time.LocalDateTime endTime = promo.getEndTime();
                String isoEnd = endTime != null ? endTime.toString() : "";
                String isoStart = startTime != null ? startTime.toString() : "";
                String countdownId = "countdown-" + promo.getId();
                String startLabel = startTime != null ? startTime.format(dateFormatter) : "Upcoming";
                String endLabel = endTime != null ? endTime.format(dateFormatter) : "To be determined";
        %>
        <div class="col-md-6 col-lg-4">
            <article class="promo-highlight-card h-100" data-end-time="<%= isoEnd %>" data-start-time="<%= isoStart %>">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="promo-pill <%= promo.isPercentage() ? "is-percentage" : "" %>">
                        <%= promo.isPercentage() ? decimalFormat.format(promo.getDiscountValue()) + "%" : "-" + decimalFormat.format(promo.getDiscountValue()) + " EUR" %>
                    </span>
                    <span class="promo-countdown" id="<%= countdownId %>">
                        <span class="countdown-segment">--</span>
                        <span class="countdown-separator">:</span>
                        <span class="countdown-segment">--</span>
                        <span class="countdown-separator">:</span>
                        <span class="countdown-segment">--</span>
                    </span>
                </div>
                <h3 class="h5 mb-2"><%= promo.getTitle() %></h3>
                <p class="mb-3 text-muted"><%= promo.getDescription() %></p>
                <p class="small text-muted mb-1">Starts: <strong><%= startLabel %></strong></p>
                <p class="small text-muted mb-0">Ends: <strong><%= endLabel %></strong></p>
            </article>
        </div>
        <%
            }
        %>
    </div>
</section>
<%
        }
    }
%>
