<%@ page import="java.util.*,org.example.model.Category,org.example.model.SubCategory,org.example.model.User" %>
<%
    List<Category> navCats = (List<Category>) request.getAttribute("navCategories");
    if (navCats == null) {
        navCats = Collections.emptyList();
    }
    String navigationDataError = (String) request.getAttribute("navigationDataError");
    String currentPath = request.getRequestURI();
    boolean isHome = currentPath.endsWith("/home") || currentPath.endsWith("/home.jsp") || "/".equals(currentPath);
    boolean isProducts = currentPath.contains("/products") || currentPath.contains("/product");
    boolean isLogin = currentPath.contains("/login");
    boolean isRegister = currentPath.contains("/register");
    boolean isCart = currentPath.contains("/cart");
    boolean isDashboard = currentPath.contains("/admin/orders");
    Integer cartCount = (Integer) request.getAttribute("cartCount");
    if (cartCount == null) cartCount = 0;
    User currentUser = (User) request.getAttribute("currentUser");
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${pageContext.request.contextPath}/home">MyShop</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link <%= isHome ? "active" : "" %>" href="${pageContext.request.contextPath}/home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= isProducts ? "active" : "" %>" href="${pageContext.request.contextPath}/products">Catalog</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle <%= isProducts ? "active" : "" %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Worlds &amp; categories
                    </a>
                    <div class="dropdown-menu p-3 shadow-lg border-0" style="min-width: 320px;">
                        <%
                            if (navCats.isEmpty()) {
                        %>
                        <span class="dropdown-item text-muted">Create categories to feed the menu.</span>
                        <%
                            } else {
                                for (Category category : navCats) {
                                    List<SubCategory> subList = category.getSubCategories();
                        %>
                        <div class="mb-3">
                            <a class="dropdown-item fw-semibold" href="${pageContext.request.contextPath}/products?categoryId=<%= category.getId() %>"><%= category.getName() %></a>
                            <p class="small text-muted mb-2"><%= category.getDescription() != null ? category.getDescription() : "Explore the selection." %></p>
                            <div class="d-flex flex-wrap gap-1">
                                <%
                                    if (subList != null && !subList.isEmpty()) {
                                        for (SubCategory sub : subList) {
                                %>
                                <a class="badge bg-light text-dark text-decoration-none" href="${pageContext.request.contextPath}/products?subCategoryId=<%= sub.getId() %>"><%= sub.getName() %></a>
                                <%
                                        }
                                    } else {
                                %>
                                <span class="badge bg-secondary-subtle text-secondary">Sub-categories coming soon</span>
                                <%
                                    }
                                %>
                            </div>
                        </div>
                        <%
                                }
                            }
                        %>
                    </div>
                </li>
            </ul>
            <div class="d-flex align-items-lg-center gap-2 flex-wrap">
                <%
                    if (navigationDataError != null) {
                %>
                <span class="badge text-bg-warning">Navigation: <%= navigationDataError %></span>
                <%
                    }
                %>
                <a class="btn btn-outline-light position-relative <%= isCart ? "active" : "" %>" href="${pageContext.request.contextPath}/cart">
                    Cart
                    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill"><%= cartCount %></span>
                </a>
                <%
                    if (currentUser != null) {
                %>
                <%
                    boolean isAdmin = currentUser.getRole() != null && currentUser.getRole().equalsIgnoreCase("ADMIN");
                    if (isAdmin) {
                %>
                <a class="btn btn-outline-light <%= isDashboard ? "active" : "" %>" href="${pageContext.request.contextPath}/admin/orders">Orders</a>
                <%
                    }
                %>
                <span class="text-light">Hello, <%= currentUser.getUsername() %></span>
                <a class="btn btn-light btn-sm" href="${pageContext.request.contextPath}/logout">Logout</a>
                <%
                    } else {
                %>
                <a class="btn btn-outline-light btn-sm <%= isLogin ? "active" : "" %>" href="${pageContext.request.contextPath}/login">Login</a>
                <a class="btn btn-primary btn-sm <%= isRegister ? "active" : "" %>" href="${pageContext.request.contextPath}/register">Register</a>
                <%
                    }
                %>
            </div>
        </div>
    </div>
</nav>
